{
  "name": "life-board-app",
  "version": "1.0.0",
  "private": true,
  "description": "Life Board Desktop App",
  "homepage": "https://github.com/nathanmota-dev/life-board#readme",
  "bugs": {
    "url": "https://github.com/nathanmota-dev/life-board/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathanmota-dev/life-board.git"
  },
  "license": "MIT",
  "author": "github.com/nathanmota-dev",
  "type": "commonjs",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch --noSandbox",
    "start": "electron-vite preview --skipBuild --noSandbox",
    "test": "npm run test --workspace web",
    "test:watch": "npm run test:watch --workspace web",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p web/tsconfig.json",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --config desktop/electron-builder.yml",
    "postinstall": "install-electron"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9",
    "vite": "^7.3.7"
  },
  "workspaces": [
    "web"
  ]
}
