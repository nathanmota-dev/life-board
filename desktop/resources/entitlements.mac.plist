<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime exceptions for the Developer ID app and all of its helpers.
     V8 needs JIT in the main process, renderers and the utilityProcess backend;
     @electron/osx-sign 1.3 grants nothing else to Electron 44's helpers. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
