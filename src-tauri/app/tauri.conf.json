{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Life Board",
  "version": "../../package.json",
  "identifier": "dev.nathanmota.lifeboard",
  "build": {
    "frontendDist": "../../out/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://127.0.0.1:* https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* https://api.open-meteo.com https://ipwho.is https://ipapi.co",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../desktop/resources/icon.png"]
  }
}
